# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_SECRET=

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/{{PROJECT_NAME}}_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{PROJECT_NAME}}_dev
DB_USER=
DB_PASSWORD=

# ─────────────────────────────────────────
# QUEUE ADAPTER
# ─────────────────────────────────────────
QUEUE_ADAPTER=graphile
# QUEUE_ADAPTER=redis (descomentar para usar Redis)
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# CACHE ADAPTER
# ─────────────────────────────────────────
CACHE_ADAPTER=memory
# CACHE_ADAPTER=redis (descomentar para usar Redis)

# ─────────────────────────────────────────
# STORAGE (MinIO / S3)
# ─────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET={{PROJECT_NAME}}-media
MINIO_PUBLIC_URL=http://localhost:9000/{{PROJECT_NAME}}-media

# ─────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────
# NOTIFICACIONES
# ─────────────────────────────────────────
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# ─────────────────────────────────────────
# PAGOS
# ─────────────────────────────────────────
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ─────────────────────────────────────────
# ENGINE STATE (solo para operadores Wodlie)
# ─────────────────────────────────────────
STATE_ADAPTER=local
# STATE_ADAPTER=postgres (plataforma Wodlie futura)
# WODLIE_ENGINE_DB_URL=postgresql://...

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
