# =============================================================
# frontend-public — variables de entorno
# =============================================================
# Copiar como .env.development / .env.test / .env.production
# Solo este archivo (.env.example) va en git — sin valores reales.
# Las vars con prefijo NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================


# ─── App ─────────────────────────────────────────────────────
# URL canónica de este frontend. Usada para generar sitemap,
# og:url y el parámetro ?redirect= del login unificado.

NEXT_PUBLIC_APP_NAME={{CLIENT_NAME}}
NEXT_PUBLIC_APP_URL=http://localhost:3001

# URL del panel admin para resolver ?redirect=admin&path=<ruta-relativa>
# en el login unificado.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002


# ─── API ─────────────────────────────────────────────────────
# Endpoint HTTP del backend-api consumido desde el navegador.
# En producción: https://api.{{DOMAIN}}

NEXT_PUBLIC_EXTERNAL_API_URL=http://localhost:3000

# Endpoint interno de Docker para SSR/server components.

INTERNAL_API_URL=http://backend-api:3000


# ─── Auth ────────────────────────────────────────────────────
# El frontend-public es el host del login unificado para ambas apps.
# La cookie 'auth-token' usa el dominio compartido para que
# admin.{{DOMAIN}} también la pueda leer.
#
# PENDIENTE: cuando el backend implemente JWT, reemplazar NEXTAUTH_*
# por la validación de cookie HttpOnly con 'jose'. Ver CONTEXT_AI.md.

NEXT_PUBLIC_COOKIE_DOMAIN=localhost
# Producción: NEXT_PUBLIC_COOKIE_DOMAIN=.{{DOMAIN}}

JWT_SECRET=
# Mismo valor que en backend-api. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=


# ─── Media ───────────────────────────────────────────────────
# Host público de media-nginx para next/image y assets remotos.

MEDIA_PUBLIC_URL=http://localhost:9000/uploads


# ─── Dev server ──────────────────────────────────────────────
# Orígenes autorizados para HMR (WebSocket de Next.js dev server).
# Solo aplica en desarrollo — ignorado en test y producción (standalone).
# Lista separada por comas. Agregar subdominios locales si se usan.

NEXT_ALLOWED_DEV_ORIGINS={{PROJECT_NAME}}.local

# Activa polling de Webpack solo para HMR en Docker/Windows.
# Mantener false en test/producción para que Next build use Turbopack sin config webpack.

WATCHPACK_POLLING=false


# ─── Testing ─────────────────────────────────────────────────

PLAYWRIGHT_BASE_URL=http://localhost:3001
