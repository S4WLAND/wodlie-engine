# =============================================================
# backend-api — variables de entorno
# =============================================================
# Copiar como .env.development / .env.test / .env.production
# Solo este archivo (.env.example) va en git — sin valores reales.
# =============================================================


# ─── App ─────────────────────────────────────────────────────
# Identidad del proceso HTTP.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
HTTP2_ENABLED=false
LOG_LEVEL=debug

# ─── JWT ─────────────────────────────────────────────────────
# Base mínima para el plugin auth y middleware futuro.
# En development se usa un fallback seguro sólo para arrancar rápido;
# en entornos reales definir un valor explícito.

JWT_SECRET=


# ─── Base de datos ────────────────────────────────────────────
# En esta base inicial puede quedar vacía.
# Se vuelve obligatoria cuando un módulo usa persistencia real.

DATABASE_URL=postgresql://user:password@localhost:5432/{{PROJECT_NAME}}_dev


# ─── Cola de trabajos ────────────────────────────────────────
# Reservado para módulos que usen jobs async.
# graphile: usa PostgreSQL.
# redis: requiere Redis.

QUEUE_ADAPTER=graphile
# QUEUE_ADAPTER=redis
REDIS_URL=redis://localhost:6379


# ─── Cache ───────────────────────────────────────────────────
# memory (default): in-process, se pierde al reiniciar.
# redis: compartida entre instancias, requiere REDIS_URL.

CACHE_ADAPTER=memory
# CACHE_ADAPTER=redis


# ─── Storage — media local ───────────────────────────────────
# Fastify procesa uploads y escribe en un volumen local.
# media-nginx sirve ese mismo directorio en modo lectura.

MEDIA_STORAGE_DIR=/app/storage/uploads
MEDIA_PUBLIC_URL=http://localhost:9000/uploads
MEDIA_MAX_IMAGE_WIDTH=1200
MEDIA_IMAGE_QUALITY=75


# ─── CORS ────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos.
# En producción: https://{{DOMAIN}},https://admin.{{DOMAIN}}

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
