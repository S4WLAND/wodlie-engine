# =============================================================
# backend-api — variables de entorno
# =============================================================
# Copiar como .env.development / .env.test / .env.production
# Solo este archivo (.env.example) va en git — sin valores reales.
# =============================================================

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=

# ─── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/{{PROJECT_NAME}}_dev

# ─── Cola de trabajos ────────────────────────────────────────
QUEUE_ADAPTER=graphile
# QUEUE_ADAPTER=redis
REDIS_URL=redis://localhost:6379

# ─── Cache ───────────────────────────────────────────────────
CACHE_ADAPTER=memory
# CACHE_ADAPTER=redis

# ─── Storage — MinIO / S3 ────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET={{PROJECT_NAME}}-media
MINIO_PUBLIC_URL=http://localhost:9000/{{PROJECT_NAME}}-media

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
