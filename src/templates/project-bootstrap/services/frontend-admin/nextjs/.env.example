# =============================================================
# frontend-admin — variables de entorno
# =============================================================
# Copiar como .env.development / .env.test / .env.production
# Solo este archivo (.env.example) va en git — sin valores reales.
# Las vars con prefijo NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================


# ─── App ─────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME={{CLIENT_NAME}} Admin


# ─── API ─────────────────────────────────────────────────────
# Endpoint HTTP del backend-api consumido desde el navegador.
# En producción: https://api.{{DOMAIN}}

NEXT_PUBLIC_EXTERNAL_API_URL=http://localhost:3000

# Endpoint interno de Docker para SSR/server components.

INTERNAL_API_URL=http://backend-api:3000


# ─── Auth ────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL apunta al frontend-PUBLIC porque el login
# es compartido: si no hay sesión, el admin redirige al login del public.
#
# NEXT_PUBLIC_COOKIE_DOMAIN debe coincidir con el del frontend-public
# y con el Domain= de la cookie que emite el backend.
#
# JWT_SECRET se usa en middleware.ts para validar la firma del token
# con 'jose'. Debe ser el mismo valor que en backend-api.
# PENDIENTE: activar cuando el backend implemente auth. Ver CONTEXT_AI.md.

NEXT_PUBLIC_APP_URL=http://localhost:3001
# Producción: NEXT_PUBLIC_APP_URL=https://{{DOMAIN}}

NEXT_PUBLIC_COOKIE_DOMAIN=localhost
# Producción: NEXT_PUBLIC_COOKIE_DOMAIN=.{{DOMAIN}}

JWT_SECRET=
# Mismo valor que en backend-api. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32


# ─── Media ───────────────────────────────────────────────────
# Host público de media-nginx para next/image y assets del panel.

MEDIA_PUBLIC_URL=http://localhost:9000/uploads


# ─── Realtime ────────────────────────────────────────────────
# URL del servidor WebSocket del backend para eventos en tiempo real
# (notificaciones, cambios de estado de turnos, alertas).
#
# polling: modo seguro por defecto, no requiere WS corriendo.
# websocket: activar cuando el backend tenga el adaptador listo.

NEXT_PUBLIC_REALTIME_ADAPTER=polling
# NEXT_PUBLIC_REALTIME_ADAPTER=websocket
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000
NEXT_PUBLIC_POLLING_INTERVAL=30000


# ─── Dev server ──────────────────────────────────────────────
# Orígenes autorizados para HMR (WebSocket de Next.js dev server).
# Solo aplica en desarrollo — ignorado en test y producción (standalone).
# Lista separada por comas. Agregar subdominios locales si se usan.

NEXT_ALLOWED_DEV_ORIGINS=admin.{{PROJECT_NAME}}.local

# Activa polling de Webpack solo para HMR en Docker/Windows.
# Mantener false en test/producción para que Next build use Turbopack sin config webpack.

WATCHPACK_POLLING=false


# ─── Testing ─────────────────────────────────────────────────

PLAYWRIGHT_BASE_URL=http://localhost:3002
