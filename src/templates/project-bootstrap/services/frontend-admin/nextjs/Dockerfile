FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_EXTERNAL_API_URL
ARG INTERNAL_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_COOKIE_DOMAIN
ARG MEDIA_PUBLIC_URL
ARG NEXT_PUBLIC_REALTIME_ADAPTER
ARG NEXT_PUBLIC_POLLING_INTERVAL
ARG PLAYWRIGHT_BASE_URL
ENV NEXT_PUBLIC_EXTERNAL_API_URL=${NEXT_PUBLIC_EXTERNAL_API_URL}
ENV INTERNAL_API_URL=${INTERNAL_API_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_COOKIE_DOMAIN=${NEXT_PUBLIC_COOKIE_DOMAIN}
ENV MEDIA_PUBLIC_URL=${MEDIA_PUBLIC_URL}
ENV NEXT_PUBLIC_REALTIME_ADAPTER=${NEXT_PUBLIC_REALTIME_ADAPTER}
ENV NEXT_PUBLIC_POLLING_INTERVAL=${NEXT_PUBLIC_POLLING_INTERVAL}
ENV PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL}
COPY package*.json ./
RUN npm ci
COPY . .
RUN mkdir -p public && touch public/.gitkeep && npm run build

FROM node:20-alpine AS production
WORKDIR /app
ARG APP_RUNTIME_PORT
ARG APP_RUNTIME_HOST
ENV NODE_ENV=production
ENV PORT=${APP_RUNTIME_PORT}
ENV HOSTNAME=${APP_RUNTIME_HOST}
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE ${APP_RUNTIME_PORT}
CMD ["node", "server.js"]
