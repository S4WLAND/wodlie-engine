# ─────────────────────────────────────────
# STACK IDENTITY
# ─────────────────────────────────────────
PROJECT_NAME={{PROJECT_NAME}}
COMPOSE_STACK_NAME=test
COMPOSE_VOLUME_PREFIX={{PROJECT_NAME}}_test

# ─────────────────────────────────────────
# RUNTIME IMAGES AND COMMANDS
# ─────────────────────────────────────────
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MEDIA_NGINX_IMAGE=nginx:1.27-alpine
DEV_NODE_IMAGE=node:20-alpine
BACKEND_DEV_COMMAND=npm install && npm run dev
FRONTEND_PUBLIC_DEV_COMMAND=npm install && npm run dev
FRONTEND_ADMIN_DEV_COMMAND=npm install && npm run dev
REDIS_APPENDONLY=yes

# ─────────────────────────────────────────
# INTERNAL CONTAINER PORTS
# ─────────────────────────────────────────
POSTGRES_CONTAINER_PORT=5432
REDIS_CONTAINER_PORT=6379
MEDIA_CONTAINER_PORT=80
BACKEND_CONTAINER_PORT=3000
FRONTEND_PUBLIC_CONTAINER_PORT=3001
FRONTEND_ADMIN_CONTAINER_PORT=3002

# ─────────────────────────────────────────
# HOST PORTS
# ─────────────────────────────────────────
BACKEND_PORT=3100
FRONTEND_PUBLIC_PORT=3101
FRONTEND_ADMIN_PORT=3102
POSTGRES_PORT=55432
REDIS_PORT=16379
MEDIA_PORT=9100

# ─────────────────────────────────────────
# PUBLIC URLS OF THE LOCAL TEST STACK
# ─────────────────────────────────────────
BACKEND_PUBLIC_URL=http://localhost:3100
FRONTEND_PUBLIC_APP_URL=http://localhost:3101
FRONTEND_ADMIN_APP_URL=http://localhost:3102
MEDIA_PUBLIC_URL=http://localhost:9100/uploads
MEDIA_STORAGE_HOST_PATH=../../.dev/storage/test/uploads

# ─────────────────────────────────────────
# BACKEND RUNTIME DEFAULTS
# ─────────────────────────────────────────
BACKEND_RUNTIME_NODE_ENV=test
BACKEND_RUNTIME_HOST=0.0.0.0
BACKEND_RUNTIME_HTTP2_ENABLED=false
BACKEND_RUNTIME_LOG_LEVEL=info
BACKEND_RUNTIME_JWT_SECRET=local-test-jwt-secret-change-me-2026
BACKEND_RUNTIME_DATABASE_URL=postgresql://{{PROJECT_NAME}}:{{PROJECT_NAME}}_test@postgres:5432/{{PROJECT_NAME}}_test
BACKEND_RUNTIME_DB_HOST=postgres
BACKEND_RUNTIME_DB_PORT=5432
BACKEND_RUNTIME_DB_NAME={{PROJECT_NAME}}_test
BACKEND_RUNTIME_DB_USER={{PROJECT_NAME}}
BACKEND_RUNTIME_DB_PASSWORD={{PROJECT_NAME}}_test
BACKEND_RUNTIME_REDIS_URL=redis://redis:6379
BACKEND_RUNTIME_MEDIA_STORAGE_DIR=/app/storage/uploads
BACKEND_RUNTIME_MEDIA_PUBLIC_URL=http://localhost:9100/uploads
BACKEND_RUNTIME_MEDIA_MAX_IMAGE_WIDTH=1200
BACKEND_RUNTIME_MEDIA_IMAGE_QUALITY=75
BACKEND_RUNTIME_ALLOWED_ORIGINS=http://localhost:3101,http://localhost:3102

# ─────────────────────────────────────────
# FRONTEND-PUBLIC RUNTIME DEFAULTS
# ─────────────────────────────────────────
FRONTEND_PUBLIC_RUNTIME_NODE_ENV=production
FRONTEND_PUBLIC_RUNTIME_HOST=0.0.0.0
FRONTEND_PUBLIC_RUNTIME_APP_NAME={{CLIENT_NAME}}
FRONTEND_PUBLIC_RUNTIME_EXTERNAL_API_URL=http://localhost:3100
FRONTEND_PUBLIC_RUNTIME_INTERNAL_API_URL=http://backend-api:3000
FRONTEND_PUBLIC_RUNTIME_APP_URL=http://localhost:3101
FRONTEND_PUBLIC_RUNTIME_ADMIN_URL=http://localhost:3102
FRONTEND_PUBLIC_RUNTIME_COOKIE_DOMAIN=localhost
FRONTEND_PUBLIC_RUNTIME_NEXTAUTH_URL=http://localhost:3101
FRONTEND_PUBLIC_RUNTIME_NEXTAUTH_SECRET=
FRONTEND_PUBLIC_RUNTIME_MEDIA_PUBLIC_URL=http://localhost:9100/uploads
FRONTEND_PUBLIC_RUNTIME_PLAYWRIGHT_BASE_URL=http://localhost:3101

# ─────────────────────────────────────────
# FRONTEND-ADMIN RUNTIME DEFAULTS
# ─────────────────────────────────────────
FRONTEND_ADMIN_RUNTIME_NODE_ENV=production
FRONTEND_ADMIN_RUNTIME_HOST=0.0.0.0
FRONTEND_ADMIN_RUNTIME_APP_NAME={{CLIENT_NAME}} Admin
FRONTEND_ADMIN_RUNTIME_EXTERNAL_API_URL=http://localhost:3100
FRONTEND_ADMIN_RUNTIME_INTERNAL_API_URL=http://backend-api:3000
FRONTEND_ADMIN_RUNTIME_APP_URL=http://localhost:3101
FRONTEND_ADMIN_RUNTIME_COOKIE_DOMAIN=localhost
FRONTEND_ADMIN_RUNTIME_MEDIA_PUBLIC_URL=http://localhost:9100/uploads
FRONTEND_ADMIN_RUNTIME_REALTIME_ADAPTER=polling
FRONTEND_ADMIN_RUNTIME_REALTIME_URL=http://localhost:3100
FRONTEND_ADMIN_RUNTIME_POLLING_INTERVAL=30000
FRONTEND_ADMIN_RUNTIME_PLAYWRIGHT_BASE_URL=http://localhost:3102

# ─────────────────────────────────────────
# SHARED DATA SERVICES
# ─────────────────────────────────────────
POSTGRES_DB={{PROJECT_NAME}}_test
POSTGRES_USER={{PROJECT_NAME}}
POSTGRES_PASSWORD={{PROJECT_NAME}}_test

# ─────────────────────────────────────────
# IMAGE TAGS
# ─────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-backend-api:test-local
FRONTEND_PUBLIC_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-frontend-public:test-local
FRONTEND_ADMIN_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-frontend-admin:test-local
