# ─────────────────────────────────────────
# PUBLIC TEST URLS
# ─────────────────────────────────────────
# Se muestran en terminal y sirven de referencia operativa para el operador.
TEST_EXPOSE_PUBLIC_URL=https://public.test.{{DOMAIN}}
TEST_EXPOSE_ADMIN_URL=https://admin.test.{{DOMAIN}}
TEST_EXPOSE_API_URL=https://api.test.{{DOMAIN}}
TEST_EXPOSE_MEDIA_URL=https://media.test.{{DOMAIN}}

# ─────────────────────────────────────────
# EXPOSE STRATEGY
# ─────────────────────────────────────────
# `ssh-command` ejecuta comandos remotos en el VPS para abrir o cerrar test.
TEST_EXPOSE_STRATEGY=ssh-command
TEST_EXPOSE_SSH_HOST=
TEST_EXPOSE_SSH_PORT=22
TEST_EXPOSE_SSH_USER=

# ─────────────────────────────────────────
# REVERSE SSH TUNNEL
# ─────────────────────────────────────────
# IP del host VPS alcanzable desde el contenedor Traefik.
TEST_EXPOSE_BIND_IP=
TEST_EXPOSE_REMOTE_BACKEND_PORT=43100
TEST_EXPOSE_REMOTE_PUBLIC_PORT=43101
TEST_EXPOSE_REMOTE_ADMIN_PORT=43102
TEST_EXPOSE_REMOTE_MEDIA_PORT=43103
TEST_EXPOSE_TRAEFIK_DYNAMIC_FILE=/etc/dokploy/traefik/dynamic/{{PROJECT_NAME}}-test-expose.yml
TEST_EXPOSE_COOKIE_DOMAIN=
