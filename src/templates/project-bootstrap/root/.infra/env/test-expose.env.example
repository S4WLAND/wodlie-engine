# ─────────────────────────────────────────
# PUBLIC TEST URLS
# ─────────────────────────────────────────
# Se muestran en terminal y sirven de referencia operativa para el operador.
TEST_EXPOSE_PUBLIC_URL=https://public.test.{{DOMAIN}}
TEST_EXPOSE_ADMIN_URL=https://admin.test.{{DOMAIN}}
TEST_EXPOSE_API_URL=https://api.test.{{DOMAIN}}

# ─────────────────────────────────────────
# EXPOSE STRATEGY
# ─────────────────────────────────────────
# `ssh-command` ejecuta comandos remotos en el VPS para exponer o cerrar test.
TEST_EXPOSE_STRATEGY=ssh-command
TEST_EXPOSE_SSH_HOST=
TEST_EXPOSE_SSH_PORT=22
TEST_EXPOSE_SSH_USER=

# ─────────────────────────────────────────
# REMOTE COMMANDS
# ─────────────────────────────────────────
# Comandos remotos del VPS que deben activar o desactivar el routing de test.
# Ejemplos típicos:
# - recargar Traefik/Caddy/Nginx
# - habilitar o retirar labels/rutas
# - actualizar un upstream al Tailscale IP de tu máquina
TEST_EXPOSE_REMOTE_UP_COMMAND=
TEST_EXPOSE_REMOTE_DOWN_COMMAND=
