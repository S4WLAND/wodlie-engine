# ─────────────────────────────────────────
# STACK IDENTITY
# ─────────────────────────────────────────
PROJECT_NAME={{PROJECT_NAME}}
COMPOSE_STACK_NAME=dev
COMPOSE_VOLUME_PREFIX={{PROJECT_NAME}}_dev
COMPOSE_PROFILES=

# ─────────────────────────────────────────
# RUNTIME IMAGES AND COMMANDS
# ─────────────────────────────────────────
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
DEV_NODE_IMAGE=node:20-alpine
BACKEND_DEV_COMMAND=npm install && npm run dev
FRONTEND_PUBLIC_DEV_COMMAND=npm install && npm run dev
FRONTEND_ADMIN_DEV_COMMAND=npm install && npm run dev
REDIS_APPENDONLY=yes
MINIO_DATA_DIR=/data

# ─────────────────────────────────────────
# INTERNAL CONTAINER PORTS
# ─────────────────────────────────────────
POSTGRES_CONTAINER_PORT=5432
REDIS_CONTAINER_PORT=6379
MINIO_API_CONTAINER_PORT=9000
MINIO_CONSOLE_CONTAINER_PORT=9001
BACKEND_CONTAINER_PORT=3000
FRONTEND_PUBLIC_CONTAINER_PORT=3001
FRONTEND_ADMIN_CONTAINER_PORT=3002

# ─────────────────────────────────────────
# HOST PORTS
# ─────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PUBLIC_PORT=3001
FRONTEND_ADMIN_PORT=3002
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─────────────────────────────────────────
# PUBLIC URLS OF THE LOCAL STACK
# ─────────────────────────────────────────
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_APP_URL=http://localhost:3001
FRONTEND_ADMIN_APP_URL=http://localhost:3002

# ─────────────────────────────────────────
# BACKEND RUNTIME DEFAULTS
# ─────────────────────────────────────────
BACKEND_RUNTIME_NODE_ENV=development
BACKEND_RUNTIME_HOST=0.0.0.0
BACKEND_RUNTIME_LOG_LEVEL=debug
BACKEND_RUNTIME_JWT_SECRET=local-dev-jwt-secret-change-me-2026
BACKEND_RUNTIME_DATABASE_URL=postgresql://{{PROJECT_NAME}}:{{PROJECT_NAME}}_dev@postgres:5432/{{PROJECT_NAME}}_dev
BACKEND_RUNTIME_DB_HOST=postgres
BACKEND_RUNTIME_DB_PORT=5432
BACKEND_RUNTIME_DB_NAME={{PROJECT_NAME}}_dev
BACKEND_RUNTIME_DB_USER={{PROJECT_NAME}}
BACKEND_RUNTIME_DB_PASSWORD={{PROJECT_NAME}}_dev
BACKEND_RUNTIME_REDIS_URL=redis://redis:6379
BACKEND_RUNTIME_MINIO_ENDPOINT=http://minio:9000
BACKEND_RUNTIME_MINIO_BUCKET={{PROJECT_NAME}}-media-dev
BACKEND_RUNTIME_MINIO_PUBLIC_URL=http://localhost:9000/{{PROJECT_NAME}}-media-dev
BACKEND_RUNTIME_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ─────────────────────────────────────────
# FRONTEND-PUBLIC RUNTIME DEFAULTS
# ─────────────────────────────────────────
FRONTEND_PUBLIC_RUNTIME_NODE_ENV=development
FRONTEND_PUBLIC_RUNTIME_HOST=0.0.0.0
FRONTEND_PUBLIC_RUNTIME_APP_NAME={{CLIENT_NAME}}
FRONTEND_PUBLIC_RUNTIME_API_URL=http://localhost:3000
FRONTEND_PUBLIC_RUNTIME_APP_URL=http://localhost:3001
FRONTEND_PUBLIC_RUNTIME_COOKIE_DOMAIN=localhost
FRONTEND_PUBLIC_RUNTIME_NEXTAUTH_URL=http://localhost:3001
FRONTEND_PUBLIC_RUNTIME_NEXTAUTH_SECRET=
FRONTEND_PUBLIC_RUNTIME_MINIO_PUBLIC_URL=http://localhost:9000/{{PROJECT_NAME}}-media-dev
FRONTEND_PUBLIC_RUNTIME_PLAYWRIGHT_BASE_URL=http://localhost:3001

# ─────────────────────────────────────────
# FRONTEND-ADMIN RUNTIME DEFAULTS
# ─────────────────────────────────────────
FRONTEND_ADMIN_RUNTIME_NODE_ENV=development
FRONTEND_ADMIN_RUNTIME_HOST=0.0.0.0
FRONTEND_ADMIN_RUNTIME_APP_NAME={{CLIENT_NAME}} Admin
FRONTEND_ADMIN_RUNTIME_API_URL=http://localhost:3000
FRONTEND_ADMIN_RUNTIME_APP_URL=http://localhost:3002
FRONTEND_ADMIN_RUNTIME_COOKIE_DOMAIN=localhost
FRONTEND_ADMIN_RUNTIME_MINIO_PUBLIC_URL=http://localhost:9000/{{PROJECT_NAME}}-media-dev
FRONTEND_ADMIN_RUNTIME_REALTIME_ADAPTER=polling
FRONTEND_ADMIN_RUNTIME_REALTIME_URL=http://localhost:3000
FRONTEND_ADMIN_RUNTIME_POLLING_INTERVAL=30000
FRONTEND_ADMIN_RUNTIME_PLAYWRIGHT_BASE_URL=http://localhost:3002

# ─────────────────────────────────────────
# SHARED DATA SERVICES
# ─────────────────────────────────────────
POSTGRES_DB={{PROJECT_NAME}}_dev
POSTGRES_USER={{PROJECT_NAME}}
POSTGRES_PASSWORD={{PROJECT_NAME}}_dev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─────────────────────────────────────────
# OPTIONAL IMAGE TAGS
# ─────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-backend-api:dev-local
FRONTEND_PUBLIC_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-frontend-public:dev-local
FRONTEND_ADMIN_IMAGE=ghcr.io/local/{{PROJECT_NAME}}-frontend-admin:dev-local
